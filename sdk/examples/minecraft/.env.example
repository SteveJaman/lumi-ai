# ── Lumi SDK connection ──────────────────────────────────────────────
LUMI_HOST=127.0.0.1
LUMI_PORT=5056

# Path to sdk_token.txt. Defaults to ../../../data/memories/sdk_token.txt
# relative to bot.js, so leave blank if you run from the project root.
LUMI_TOKEN_PATH=

# Alternative: paste the token value directly (takes precedence over the file).
# LUMI_SDK_TOKEN=

# ── Minecraft server ──────────────────────────────────────────────────
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=LumiBot

# offline | microsoft
MC_AUTH=offline

# Minecraft version string, e.g. "1.20.1". Leave blank to auto-detect.
MC_VERSION=
