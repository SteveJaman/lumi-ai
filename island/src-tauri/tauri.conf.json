{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumi Island",
  "version": "0.1.0",
  "identifier": "dev.lumi.island",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "island",
        "title": "Lumi Island",
        "url": "index.html",
        "width": 200,
        "height": 8,
        "x": 0,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self'; script-src 'self'; connect-src ws: wss: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Lumi",
    "category": "Utility",
    "shortDescription": "Lumi's top-of-screen island",
    "longDescription": "A small always-on-top island for Lumi: status, approvals, calendar, chat and the agent pipeline. Connects to Lumi on this PC, or to another PC over Tailscale with a pairing code.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
