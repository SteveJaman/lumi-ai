# ============================================================
# Lumi AI Companion — .gitignore
# Restructured for the data/ + config/ folder reorg.
# Everything the app writes at runtime lives under data/.
# Everything the user configures lives under config/.
# ============================================================

# --- Secrets & environment ---
.env
.env.local
.env.*.local
*.key
*.pem

# --- Conda ---
.conda/
*.conda

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Models & weights ---
models/
*.whl
deepspeed-*.whl
*.pt
*.pth
*.safetensors

# --- IDE / editor ---
.idea/
.vscode/
.fleet/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# RUNTIME DATA
# ------------------------------------------------------------
# data/ holds everything the app writes at runtime. The
# top-level data/README.md documents the folder and is kept;
# everything inside is generated or user-specific.
# ============================================================

# --- Browser profile (cookies, logins, cache, history) ---
data/browser_profile/

# --- Diagnostic logs ---
data/logs/
realtimesst.log
realtimesst_*.log
*.log

# --- Long-term memory + per-user state ---
# ChromaDB database, self-model, session continuity,
# emotional state, user database, SDK token.
data/memories/
!data/memories/readme.md
!data/memories/.gitkeep

# --- VTS plugin authentication token ---
data/vtubeStudio_token.txt

# --- Stored API keys (written by the Integrations page) ---
data/API/

# --- TTS output buffers ---
data/outputs/

# --- Local user-supplied documents ---
data/library/*
!data/library/.gitkeep

# --- Voice reference clips (also covered by data/voices/.gitignore) ---
data/voices/*
!data/voices/.gitignore

# --- User songs (also covered by data/songs/.gitignore) ---
data/songs/*
!data/songs/.gitignore

# --- Downloaded / vendored models (XTTS, etc.) ---
data/models/

# ============================================================
# AUDIO ARTIFACTS (root-level fallbacks)
# ============================================================
*.wav
*.mp3
*.pcm
temp_discord_audio_*.wav
test_tone.wav

# ============================================================
# BACKUPS & SCRATCH
# ============================================================
# Auto-backups made by write_file and the constants.py patcher.
*.bak
*.bak.*

# Persona editor scratch / manual backups.
config/lumi.yaml.bak
config/*.yaml.bak

# Claude Code / AI assistant scratch.
.claude/
.cursor/
.aider*

# --- Directory structure listings ---
Lumi_tree.txt