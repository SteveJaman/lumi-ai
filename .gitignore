# ============================================================
# Lumi AI Companion — .gitignore
# Restructured for the data/ + config/ folder reorg.
# Everything the app writes at runtime lives under data/.
# Everything the user configures lives under config/.
# ============================================================

# --- Secrets & environment ---
.env
.env.local
.env.*.local
*.key
*.pem

# --- Conda ---
.conda/
*.conda

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Models & weights ---
models/
*.whl
deepspeed-*.whl
*.pt
*.pth
*.safetensors

# --- IDE / editor ---
.idea/
.vscode/
.fleet/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# RUNTIME DATA
# ------------------------------------------------------------
# data/ holds everything the app writes at runtime. The
# top-level data/README.md documents the folder and is kept;
# everything inside is generated or user-specific.
# ============================================================

# --- Browser profile (cookies, logins, cache, history) ---
data/browser_profile/

# --- Diagnostic logs ---
data/logs/
realtimesst.log
realtimesst_*.log
*.log

# --- Long-term memory + per-user state ---
# ChromaDB database, self-model, session continuity,
# emotional state, user database, SDK token.
data/memories/

# OAuth client + tokens (Google, Microsoft) and the cached mailbox/calendar.
# Never commit these.
data/credentials/

# Small per-machine settings written by the web client (display.json holds
# the city you typed for the weather).
data/display.json
data/gaming_mode.json
data/island.json
# Remote island pairing (a salted hash of the code, and the Tailscale address).
data/island_remote.json
data/workspace/
!data/memories/readme.md
!data/memories/.gitkeep

# --- VTS plugin authentication token ---
data/vtubeStudio_token.txt

# --- Stored API keys (written by the Integrations page) ---
data/API/

# --- TTS output buffers ---
data/outputs/

# --- Minecraft agent telemetry, event log, skill library ---
data/minecraft/

# --- Streaming: generated tunnel config, live subtitle text ---
data/cloudflared/
data/obs_subtitles.txt

# --- npm dependencies for the Node SDK examples ---
node_modules/

# --- Local user-supplied documents ---
data/library/*
!data/library/.gitkeep

# --- Voice reference clips (also covered by data/voices/.gitignore) ---
data/voices/*
!data/voices/.gitignore

# --- User songs (also covered by data/songs/.gitignore) ---
data/songs/*
!data/songs/.gitignore

# --- Downloaded / vendored models (XTTS, etc.) ---
data/models/

# ============================================================
# AUDIO ARTIFACTS (root-level fallbacks)
# ============================================================
*.wav
*.mp3
*.pcm
temp_discord_audio_*.wav
test_tone.wav

# ============================================================
# BACKUPS & SCRATCH
# ============================================================
# Auto-backups made by write_file and the constants.py patcher.
*.bak
*.bak.*

# Persona editor scratch / manual backups.
config/lumi.yaml.bak
config/*.yaml.bak

# MCP servers: per-machine, and "env" can hold tokens. Lumi creates it
# as {"servers": []} on first boot (modules/mcp_client.py).
config/mcp_servers.json
config/mcp_servers.json.tmp

# Claude Code / AI assistant scratch.
.claude/
.cursor/
.aider*

# --- Directory structure listings ---
Lumi_tree.txt
results/
# --- Third-party source checkouts (re-clone; see scripts/build_pixel_office.py) ---
third_party/pixel-agents/
hybrid_mode.json
ui_theme.json
# --- Agent harness runtime state (modules/harness/) ---
# Tracked: data/tasks/baseline_tests.txt, data/tasks/REFACTOR_REPORT.md,
# data/hooks/*.py, data/workflows/*.json.
data/tasks/lumi_tasks.json
data/tasks/lumi_tasks.json.tmp
data/tasks/tool_outputs/
data/tasks/transcripts/
data/tasks/*.log

# --- Autonomous tasks (modules/autonomous_agent.py): the agent's scratch area ---
sandbox/
data/tasks/autonomous/
data/skills/
data/claude_usage.json
data/shortcuts.json
data/profiles/
data/browser_search_profile/

# Avatar models and their config (a personal model folder path lives in live2d.json).
data/avatars/

# Live2D Cubism Core: Live2D's own file, under its licence. Never commit it.
web/vendor/live2dcubismcore.min.js

# Mood, curiosity notes (Phase 4-5).
data/mood_state.json
data/curiosity.db
