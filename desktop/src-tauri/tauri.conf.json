{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumi",
  "version": "0.1.0",
  "identifier": "dev.lumi.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lumi",
        "url": "index.html",
        "width": 1280,
        "height": 840,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' http: https: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Lumi",
    "category": "Utility",
    "shortDescription": "Lumi, in her own window",
    "longDescription": "Lumi's web app as a desktop app. Connects to Lumi on this PC, or to your desktop from a laptop through Lumi's remote link.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" },
      "wix": { "language": "en-US" }
    }
  }
}
